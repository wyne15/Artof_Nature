# ───────────── Site ─────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────────── Supabase ─────────────
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) – safe for the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) – SERVER ONLY. Never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# ───────────── Stripe ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────── Email (Resend) ─────────────
RESEND_API_KEY=
EMAIL_FROM="The Art of Nature <orders@your-domain.co.uk>"
OWNER_EMAIL=

# ───────────── Admin security ─────────────
# Base32 secret for the authenticator app. Generate with: npm run totp:setup
ADMIN_TOTP_SECRET=
# Long random strings (>= 32 chars). `npm run totp:setup` prints fresh ones.
ADMIN_SESSION_SECRET=
# Signs email links (confirm / reset / newsletter) and customer sessions
APP_SECRET=
# Long random string used to hash IPs for rate limiting (never stores raw IPs)
IP_HASH_SALT=

# Set to "true" only after the legal pages were reviewed by a professional
NEXT_PUBLIC_LEGAL_REVIEWED=false

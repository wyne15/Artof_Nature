:root{--olive:#5C6B2E;--olive-h:#4D5A24;--olive-d:#2F3817;--gold:#D4A843;--gold-d:#7A560F;--cream:#F7F3EB;--paper:#FFFDF8;--ink:#2A2615;--muted:#6B6650;--line:rgba(42,38,21,.14);--serif:var(--font-serif),'Cormorant Garamond',Georgia,'Times New Roman',serif;--sans:var(--font-sans),'Figtree',system-ui,-apple-system,'Segoe UI',sans-serif;color-scheme:light}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
img,svg{display:block;max-width:100%}
a{color:inherit}
h1,h2,h3{font-family:var(--serif);font-weight:600;margin:0;line-height:1.1;letter-spacing:-.005em}
p{margin:0}
:focus-visible{outline:2.5px solid var(--gold-d);outline-offset:3px;border-radius:4px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 24px;border-radius:999px;border:1.5px solid transparent;font:500 15px/1 var(--sans);cursor:pointer;text-decoration:none;transition:background .2s,color .2s,border-color .2s}
.btn-gold{background:var(--gold);color:var(--ink)}.btn-gold:hover{background:#E0B957}
.btn-olive{background:var(--olive);color:#fff}.btn-olive:hover{background:var(--olive-h)}
.btn-line{border-color:var(--olive);color:var(--olive-d);background:transparent}.btn-line:hover{background:rgba(92,107,46,.1)}
.btn-ghost{color:var(--cream);padding:0 8px;text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}
.topbar{background:var(--olive-d);color:#EDE6D3;text-align:center;font-size:13px;padding:8px 12px}
.hdr{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--paper);border-bottom:1px solid var(--line)}
.hdr-in{max-width:1180px;margin:0 auto;height:64px;padding:0 20px;display:flex;align-items:center;gap:14px}.nav{margin-right:14px}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;margin-right:auto}
.brand img{width:42px;height:42px;object-fit:contain}
.brand span{font-family:var(--serif);font-size:23px;font-weight:600;color:var(--olive-d);white-space:nowrap}
.nav{display:flex;gap:26px}
.nav a{text-decoration:none;font-size:15px;font-weight:500;color:var(--ink);padding:8px 0;border-bottom:1.5px solid transparent}
.nav a:hover{border-color:var(--gold)}
.cartbtn{position:relative;width:46px;height:46px;border:none;background:transparent;color:var(--olive-d);cursor:pointer;display:flex;align-items:center;justify-content:center;border-radius:50%}
.cartbtn:hover{background:rgba(92,107,46,.1)}
.cnt{position:absolute;top:4px;right:2px;min-width:19px;height:19px;border-radius:10px;background:var(--gold);color:var(--ink);font-size:11.5px;font-weight:600;display:flex;align-items:center;justify-content:center;padding:0 5px}
.hero{background:var(--olive-d);color:var(--cream);overflow:hidden}
.hero-in{max-width:1180px;margin:0 auto;padding:0 20px;display:grid;grid-template-columns:1fr 1fr;align-items:end;min-height:min(640px,82vh)}
.hero-txt{align-self:center;padding:56px 0 64px;max-width:520px}
.hero h1{font-size:clamp(40px,5.6vw,70px);line-height:1.02;font-weight:600}
.hero p{margin:20px 0 30px;font-size:18px;line-height:1.55;color:#E6DEC9;max-width:420px}
.hero-cta{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.scene{width:100%;height:auto;max-height:640px}
.flame{transform-box:fill-box;transform-origin:50% 100%;animation:flick 3.2s ease-in-out infinite}
.mote{animation:drift 9s ease-in-out infinite}
@keyframes flick{0%,100%{transform:scale(1,1) rotate(0)}22%{transform:scale(.94,1.05) rotate(-1.6deg)}51%{transform:scale(1.04,.96) rotate(1.2deg)}77%{transform:scale(.97,1.03) rotate(-.8deg)}}
@keyframes drift{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.sec{max-width:1180px;margin:0 auto;padding:72px 20px}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:34px;flex-wrap:wrap}
.sec-head h2{font-size:clamp(32px,4.4vw,48px)}
.sec-head p{color:var(--muted);margin-top:8px;max-width:46ch}
.link{font-weight:500;color:var(--olive-d);text-underline-offset:5px;text-decoration-thickness:1px}
.hexdiv{position:relative;height:36px;overflow:hidden}
.hexdiv svg{width:100%;height:36px}
.hexdiv .bdg{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:50px;height:50px;border-radius:50%;background:var(--cream);color:var(--olive);display:flex;align-items:center;justify-content:center}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:30px 24px}
.grid.three{grid-template-columns:repeat(3,1fr)}
.card{display:flex;flex-direction:column;min-width:0}
.card .ph{position:relative;display:block;aspect-ratio:4/5;border-radius:14px;overflow:hidden;background:#EFE6D0}
.card .ph svg{position:absolute;inset:0;width:100%;height:100%;transition:opacity .45s ease}
.card .ph .b{opacity:0}
.card .ph:hover .b,.card .ph:focus-visible .b{opacity:1}
.tag{position:absolute;top:12px;left:12px;z-index:2;background:var(--paper);color:var(--olive-d);font-size:12.5px;font-weight:500;padding:4px 11px;border-radius:999px}
.card h3{font-size:25px;margin-top:16px}
.card h3 a{text-decoration:none}
.card .note{color:var(--muted);font-size:14.5px;margin-top:3px}
.card .row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px}
.price{font-family:var(--serif);font-size:26px;font-weight:600;color:var(--olive-d)}
.add{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 18px;border-radius:999px;border:1.5px solid var(--olive);background:transparent;color:var(--olive-d);font:500 14.5px var(--sans);cursor:pointer;transition:background .2s,color .2s}
.add:hover{background:var(--olive);color:#fff}
.add.done{background:var(--olive);color:#fff}
.story{position:relative;background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.story-bg{position:absolute;inset:0;width:100%;height:100%}
.story-in{position:relative;max-width:1180px;margin:0 auto;padding:80px 20px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.story-art{aspect-ratio:1/1;max-height:480px;width:100%;border-radius:14px;background:#EFE6D0;overflow:hidden}
.story h2{font-size:clamp(34px,4.6vw,52px)}
.story p{margin-top:18px;font-size:17.5px;color:#46422F;max-width:46ch;line-height:1.7}
.story .btn{margin-top:28px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:6px}
.step{padding-top:20px;border-top:2px solid var(--olive)}
.step .ic{color:var(--olive);margin-bottom:16px}
.step h3{font-size:26px}
.step p{color:var(--muted);margin-top:8px;max-width:34ch}
.step small{font-family:var(--serif);font-size:20px;color:var(--gold-d);font-weight:600}
.news{background:var(--olive-d);color:var(--cream)}
.news-in{max-width:1180px;margin:0 auto;padding:68px 20px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.news h2{font-size:clamp(32px,4.2vw,46px)}
.news p.lead{margin-top:12px;color:#DDD5BF;max-width:40ch}
.nform{display:flex;flex-direction:column;gap:14px}
.nrow{display:flex;gap:10px}
.nrow input[type=email]{flex:1;min-width:0;min-height:48px;border-radius:999px;border:1.5px solid rgba(247,243,235,.35);background:rgba(247,243,235,.08);color:var(--cream);padding:0 20px;font:400 16px var(--sans)}
.nrow input::placeholder{color:#BDB69E}
.chk{display:flex;gap:11px;align-items:flex-start;font-size:14px;color:#DDD5BF;line-height:1.5}
.chk input{margin-top:3px;width:18px;height:18px;accent-color:var(--gold);flex:none}
.chk a{color:var(--cream)}
.err{color:#FFC9B8;font-size:14px;min-height:20px}
.ok{color:var(--cream);font-size:16px;padding:14px 0}
.ftr{background:var(--cream);border-top:1px solid var(--line)}
.ftr-in{max-width:1180px;margin:0 auto;padding:52px 20px 30px;display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:40px}
.ftr-brand{color:var(--olive)}
.ftr-brand p{color:var(--muted);margin-top:14px;max-width:34ch;font-size:15px}
.ftr h3{font-family:var(--sans);font-size:14px;font-weight:600;margin-bottom:12px}
.ftr a{display:block;text-decoration:none;color:var(--muted);font-size:15px;padding:5px 0}
.ftr a:hover{color:var(--olive-d)}
.ftr-bot{max-width:1180px;margin:0 auto;padding:18px 20px 28px;border-top:1px solid var(--line);font-size:13.5px;color:var(--muted);display:flex;justify-content:space-between;gap:12px 24px;flex-wrap:wrap}.legal-l{display:flex;gap:20px;flex-wrap:wrap}.legal-l a{padding:8px 0;font-size:13.5px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.chip{min-height:42px;padding:0 18px;border-radius:999px;border:1.5px solid var(--line);background:transparent;font:500 14.5px var(--sans);color:var(--ink);cursor:pointer}
.chip{display:inline-flex;align-items:center;text-decoration:none}
.chip[aria-current=page]{background:var(--olive);border-color:var(--olive);color:#fff}
.crumb{font-size:14px;color:var(--muted);margin-bottom:22px}
.crumb a{text-underline-offset:4px}
.pdp{display:grid;grid-template-columns:1.05fr 1fr;gap:56px;align-items:start}
.gal{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;border-radius:14px;scrollbar-width:none}
.gal::-webkit-scrollbar{display:none}
.gal>div{flex:0 0 100%;scroll-snap-align:center;aspect-ratio:4/5;position:relative}
.gal svg{width:100%;height:100%}
.dots{display:flex;gap:8px;justify-content:center;margin-top:14px}
.dots i{width:8px;height:8px;border-radius:50%;background:var(--line);transition:background .2s,width .2s}
.dots i.on{background:var(--olive);width:22px;border-radius:5px}
.pdp h1{font-size:clamp(36px,4.6vw,54px)}
.pdp .pr{font-family:var(--serif);font-size:34px;font-weight:600;color:var(--olive-d);margin:14px 0 18px}
.pdp .ds{font-size:17.5px;color:#46422F;line-height:1.7;max-width:48ch}
.facts{list-style:none;padding:0;margin:26px 0;border-top:1px solid var(--line)}
.facts li{display:flex;justify-content:space-between;gap:16px;padding:13px 0;border-bottom:1px solid var(--line);font-size:15.5px}
.facts span:first-child{color:var(--muted)}
.qty{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:999px;height:48px}
.qty button{width:46px;height:46px;border:none;background:transparent;font-size:22px;cursor:pointer;color:var(--olive-d);border-radius:50%}
.qty span{min-width:28px;text-align:center;font-weight:500}
.buy{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.buy .btn{flex:1;min-width:190px}
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--paper);border-top:1px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));display:none;align-items:center;gap:14px}
.sticky .sp{font-family:var(--serif);font-size:26px;font-weight:600;color:var(--olive-d)}
.sticky .btn{flex:1}
#ovl{position:fixed;inset:0;background:rgba(30,26,12,.45);z-index:90}
#drawer{position:fixed;top:0;right:0;bottom:0;width:min(400px,100vw);background:var(--paper);z-index:100;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .35s cubic-bezier(.2,.8,.2,1);visibility:hidden}
#drawer.open{transform:none;visibility:visible}
.d-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line)}
.d-head h2{font-size:28px}
.d-head button{width:44px;height:44px;border:none;background:transparent;cursor:pointer;color:var(--ink);border-radius:50%}
.d-ship{padding:14px 20px;background:var(--cream);font-size:14.5px;border-bottom:1px solid var(--line)}
.bar{height:6px;border-radius:3px;background:rgba(92,107,46,.18);margin-top:9px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--olive);border-radius:3px;transition:width .4s ease}
.d-body{flex:1;overflow-y:auto;padding:6px 20px}
.it{display:grid;grid-template-columns:72px 1fr auto;gap:14px;padding:16px 0;border-bottom:1px solid var(--line);align-items:center}
.it .th{width:72px;height:90px;border-radius:9px;overflow:hidden}
.it .th svg{width:100%;height:100%}
.it h4{margin:0;font-family:var(--serif);font-size:20px;font-weight:600}
.it .q{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:999px;margin-top:8px;height:36px}
.it .q button{width:34px;height:34px;border:none;background:transparent;cursor:pointer;font-size:18px;color:var(--olive-d);border-radius:50%}
.it .q span{min-width:20px;text-align:center;font-size:14px}
.it .ip{font-weight:500}
.rm{display:block;margin-top:8px;background:none;border:none;color:var(--muted);font:400 13px var(--sans);text-decoration:underline;cursor:pointer;padding:4px 0;margin-left:auto}
.empty{padding:50px 10px;text-align:center;color:var(--muted)}
.empty h3{font-size:28px;color:var(--ink);margin-bottom:8px}
.d-foot{padding:18px 20px calc(18px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--line)}
.sub{display:flex;justify-content:space-between;font-size:17px;margin-bottom:14px}
.sub b{font-weight:600}
.d-foot .btn{width:100%}
.d-foot small{display:block;margin-top:10px;color:var(--muted);font-size:13px;text-align:center}
#intro{position:fixed;inset:0;z-index:1000;background:var(--cream);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .8s ease}
#intro img{position:relative;width:96px;height:96px;object-fit:contain}
.intro-name{position:relative;font-family:var(--serif);font-size:28px;font-weight:600;color:var(--olive-d);margin-top:14px}
#introSkip{position:fixed;z-index:1003;top:calc(14px + env(safe-area-inset-top,0px));right:14px;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(42,38,21,.25);background:transparent;color:var(--ink);font:500 13px var(--sans);cursor:pointer}
#fx{position:fixed;inset:0;z-index:1001;pointer-events:none}
#bee{position:fixed;left:0;top:0;width:44px;height:44px;z-index:1002;pointer-events:none;opacity:0;will-change:transform}
.bw{transform-box:fill-box;transform-origin:50% 100%;animation:bwf .09s linear infinite}
#bee.land .bw{animation-duration:.7s}
@keyframes bwf{0%,100%{transform:scaleY(1)}50%{transform:scaleY(.3)}}
@media(max-width:900px){
 .hero-in{grid-template-columns:1fr;min-height:0}
 .hero-txt{padding:44px 0 8px}
 .scene{max-height:420px;margin-top:8px}
 .story-in,.news-in,.pdp{grid-template-columns:1fr;gap:34px}
 .steps{grid-template-columns:1fr}
 .ftr-in{grid-template-columns:1fr 1fr}.ftr-brand{grid-column:1/-1}
 .grid.three{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:16px;margin:0 -20px;padding:0 20px 8px;scrollbar-width:none}
 .grid.three::-webkit-scrollbar{display:none}
 .grid.three .card{flex:0 0 76%;scroll-snap-align:start}
 .sec{padding:54px 20px}
 .story-in{padding:56px 20px}
}
@media(max-width:640px){
 .nav{display:none}
 .brand span{font-size:20px}
 .grid{grid-template-columns:repeat(2,1fr);gap:26px 14px}
 .grid.three{display:flex}
 .card h3{font-size:21px}
 .card .row{flex-direction:column;align-items:stretch;gap:10px}
 .card .add{justify-content:center}
 .price{font-size:23px}
 .nrow{flex-direction:column}
 .sticky{display:flex}
 .pdp-page{padding-bottom:84px}
 .buy .btn.main{display:none}
}
@media(prefers-reduced-motion:reduce){
 .flame,.mote,.bw{animation:none}
 #drawer,.card .ph svg{transition:none}
 html{scroll-behavior:auto}
}

#acBtn{text-decoration:none}
.ini{width:32px;height:32px;border-radius:50%;background:var(--olive);color:#fff;font-weight:600;font-size:14px;display:flex;align-items:center;justify-content:center}
.acct{max-width:520px;margin:0 auto}.acct.wide2{max-width:760px}
.acct h1{font-size:clamp(34px,5vw,48px)}
.sub2{color:var(--muted);margin:10px 0 22px;max-width:46ch}
.tabs{display:flex;gap:6px;border-bottom:1px solid var(--line);margin-bottom:0;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabbtn{flex:none;min-height:46px;padding:0 18px;border:none;background:transparent;font:500 15px var(--sans);color:var(--muted);cursor:pointer;border-bottom:2.5px solid transparent;margin-bottom:-1px}
.tabbtn[aria-selected=true]{color:var(--olive-d);border-color:var(--olive)}
.panel{background:var(--paper);border:1px solid var(--line);border-top:none;border-radius:0 0 14px 14px;padding:26px 22px}
.fld{margin-bottom:16px}
.fld label{display:block;font-size:14.5px;font-weight:500;margin-bottom:6px}
.fld input{width:100%;min-height:48px;border:1.5px solid rgba(42,38,21,.28);border-radius:10px;background:#fff;padding:0 14px;font:400 16px var(--sans);color:var(--ink)}
.fld input:focus{outline:2.5px solid var(--gold-d);outline-offset:1px;border-color:var(--olive)}
.fld small{display:block;color:var(--muted);font-size:13.5px;margin-top:6px}
.pw{position:relative}.pw input{padding-right:70px}
.pw button{position:absolute;right:4px;top:4px;height:40px;min-width:60px;border:none;background:transparent;color:var(--olive-d);font:500 14px var(--sans);cursor:pointer;border-radius:8px}
.chk2{display:flex;gap:11px;align-items:flex-start;font-size:14.5px;line-height:1.5;margin:0 0 12px}
.chk2 input{margin-top:3px;width:18px;height:18px;accent-color:var(--olive);flex:none}
.ferr{color:#9B2C1B;font-size:14.5px;min-height:22px;margin-bottom:8px}
.btn.wide{width:100%}
.alt{margin-top:16px;font-size:14.5px;color:var(--muted);text-align:center}
.lnk{background:none;border:none;color:var(--olive-d);font:500 14.5px var(--sans);text-decoration:underline;text-underline-offset:4px;cursor:pointer;padding:8px 4px;min-height:40px}
.lead2{color:var(--muted);margin-bottom:16px}
.msg h2{font-size:30px;margin-bottom:10px}.msg p{color:#46422F;margin-bottom:18px}
.flash{background:#E6E9D3;border:1px solid rgba(92,107,46,.4);color:var(--olive-d);padding:12px 16px;border-radius:10px;margin:0 0 18px;font-size:15px}
.ahead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
.two{display:flex;gap:12px;flex-wrap:wrap}.two>.fld{flex:1;min-width:140px}
.ord{display:flex;justify-content:space-between;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)}
.ord:first-child{padding-top:0}
.ord p{margin-top:6px;font-size:15px;color:#46422F}.ord small{color:var(--muted);font-size:13.5px}
.ord .ot{font-family:var(--serif);font-size:26px;font-weight:600;color:var(--olive-d)}
.pill{display:inline-block;margin-left:10px;background:#E6E9D3;color:var(--olive-d);font-size:12.5px;font-weight:500;padding:3px 10px;border-radius:999px}
.priv h3{font-size:24px;margin:6px 0 12px}.priv h3:not(:first-child){margin-top:26px}
.priv p{color:#46422F;margin-bottom:14px}
.msg2{margin-top:16px;font-size:15px;color:#46422F}

.cnt[hidden]{display:none}

.mbtn{display:none}
#mnu{border-top:1px solid var(--line);padding:4px 20px 12px;background:var(--paper)}
#mnu[hidden]{display:none}
#mnu a{display:block;padding:15px 0;font-family:var(--serif);font-size:23px;font-weight:600;text-decoration:none;border-bottom:1px solid var(--line);color:var(--olive-d)}
.fld select,.fld textarea{width:100%;border:1.5px solid rgba(42,38,21,.28);border-radius:10px;background:#fff;padding:12px 14px;font:400 16px var(--sans);color:var(--ink)}
.fld select{min-height:48px}.fld textarea{resize:vertical;min-height:130px}
.fld select:focus,.fld textarea:focus{outline:2.5px solid var(--gold-d);outline-offset:1px;border-color:var(--olive)}
.hp{position:absolute;left:-9999px;height:0;overflow:hidden}
.ct{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;max-width:1000px;margin:0 auto}
.ct h1{font-size:clamp(36px,5vw,54px)}
.panel.full{border:1px solid var(--line);border-radius:14px}
.cinfo{list-style:none;padding:0;margin:0 0 20px;border-top:1px solid var(--line)}
.cinfo li{display:flex;flex-direction:column;gap:2px;padding:14px 0;border-bottom:1px solid var(--line)}
.cinfo b{font-weight:500;color:var(--muted);font-size:14px}
.alt2{color:var(--muted);font-size:15px;margin-top:18px}
.story2{background:var(--cream)}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.two-col h1{font-size:clamp(40px,5.4vw,64px);margin-bottom:20px}
.two-col p{margin-top:16px;font-size:17.5px;color:#46422F;max-width:46ch;line-height:1.7}
.two-col p.big{font-family:var(--serif);font-size:clamp(24px,3vw,32px);line-height:1.25;color:var(--ink);font-weight:500}
.two-col .btn{margin-top:26px}
.legal{max-width:720px;margin:0 auto}
.legal h1{font-size:clamp(36px,5vw,52px)}
.legal h2{font-size:28px;margin:32px 0 8px}
.legal p{color:#46422F;line-height:1.75;margin-top:10px}
.legal .upd{margin-top:36px;color:var(--muted);font-size:14px}
.faq{border-top:1px solid var(--line)}
.faq details{border-bottom:1px solid var(--line)}
.faq summary{cursor:pointer;list-style:none;padding:20px 40px 20px 0;font-family:var(--serif);font-size:24px;font-weight:600;position:relative;min-height:44px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';position:absolute;right:6px;top:50%;transform:translateY(-52%);font:400 28px var(--sans);color:var(--olive)}
.faq details[open] summary::after{content:'\2212'}
.faq details p{padding:0 40px 22px 0;color:#46422F;line-height:1.7}
.nf{text-align:center}
.nf-in{max-width:560px;margin:0 auto;padding:36px 0 20px}
.nf-bee{color:var(--olive);display:flex;justify-content:center;margin-bottom:20px}
.nf h1{font-size:clamp(36px,5vw,54px)}
.nf p{color:#46422F;margin:14px 0 24px;line-height:1.7}
@media(max-width:900px){.ct,.two-col{grid-template-columns:1fr;gap:34px}}
@media(max-width:640px){.mbtn{display:flex}.faq summary{font-size:21px}}

body.adm .topbar,body.adm .hdr,body.adm .ftr,body.adm #drawer,body.adm #ovl{display:none}
body.adm{background:#F3EFE6}
.adm-wrap{min-height:100vh;display:grid;grid-template-columns:240px 1fr}
.adm-side{background:var(--olive-d);color:var(--cream);padding:24px 14px;display:flex;flex-direction:column;gap:18px;position:sticky;top:0;height:100vh}
.adm-brand{font-family:var(--serif);font-size:24px;font-weight:600;padding:0 10px}.adm-brand small{display:block;font:500 12.5px var(--sans);color:#CFC7AE;margin-top:2px}
.adm-side nav{display:flex;flex-direction:column;gap:4px}
.adm-side nav button{display:flex;align-items:center;justify-content:space-between;min-height:46px;padding:0 12px;border:none;border-radius:10px;background:transparent;color:#E6DEC9;font:500 15px var(--sans);cursor:pointer;text-align:left}
.adm-side nav button[aria-current=true]{background:rgba(247,243,235,.14);color:#fff}
.adm-side nav button:hover{background:rgba(247,243,235,.1)}
.adm-side nav i{font-style:normal;background:var(--gold);color:var(--ink);font-size:12px;font-weight:600;min-width:22px;height:22px;border-radius:11px;display:flex;align-items:center;justify-content:center;padding:0 6px}
.adm-foot{margin-top:auto;display:flex;flex-direction:column;gap:2px}
.adm-foot a,.adm-foot button{display:block;text-align:left;padding:12px;border:none;background:transparent;color:#CFC7AE;font:400 14.5px var(--sans);text-decoration:none;cursor:pointer;border-radius:8px}
.adm-foot a:hover,.adm-foot button:hover{background:rgba(247,243,235,.1);color:#fff}
.adm-main{padding:34px clamp(18px,4vw,44px) 60px;max-width:980px;width:100%}
.adm-main h1{font-size:clamp(32px,4vw,44px)}
.h2s{font-size:26px;margin:30px 0 12px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:20px}
.stat{display:flex;flex-direction:column;gap:2px;text-align:left;padding:18px;background:var(--paper);border:1px solid var(--line);border-radius:14px;cursor:pointer;font-family:var(--sans);color:var(--ink)}
.stat span{font-size:14px;color:var(--muted)}.stat b{font-family:var(--serif);font-size:36px;font-weight:600;color:var(--olive-d);line-height:1.15}.stat small{font-size:13px;color:var(--muted)}
.stat:hover{border-color:var(--olive)}
.list{display:flex;flex-direction:column;gap:10px;margin-top:16px}
.li{display:flex;align-items:center;justify-content:space-between;gap:16px;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px 16px;flex-wrap:wrap}
.li small{display:block;color:var(--muted);font-size:13.5px;margin-top:2px}
.pill.warn{background:#F6E3C0;color:#6B4A0A}
.ord2{align-items:flex-start}
.oi{flex:1;min-width:200px}.od{color:var(--muted);font-size:13.5px;margin-left:10px}
.oa{display:flex;align-items:center;gap:14px}
.ord2 .ot{font-family:var(--serif);font-size:24px;color:var(--olive-d)}
.li select,.adm-card select{min-height:44px;border:1.5px solid rgba(42,38,21,.28);border-radius:10px;background:#fff;padding:0 12px;font:400 15px var(--sans);color:var(--ink)}
.trk{display:flex;gap:10px;width:100%;flex-wrap:wrap}
.trk input{flex:1;min-width:180px;min-height:44px;border:1.5px solid rgba(42,38,21,.28);border-radius:10px;padding:0 12px;font:400 15px var(--sans)}
.btn.sm{min-height:44px;padding:0 16px;font-size:14px}
.prow{display:grid;grid-template-columns:1fr auto auto auto;gap:14px;align-items:center}
.pn{display:flex;gap:12px;align-items:center;min-width:0}.pth{width:48px;height:60px;border-radius:8px;overflow:hidden;flex:none}.pth svg{width:100%;height:100%}
.mini{display:flex;flex-direction:column;gap:3px;font-size:12.5px;color:var(--muted)}
.mini input[type=number]{width:84px;min-height:44px;border:1.5px solid rgba(42,38,21,.28);border-radius:10px;padding:0 10px;font:400 15px var(--sans);color:var(--ink)}
.mini.tg{flex-direction:row;align-items:center;gap:8px;font-size:14px;color:var(--ink)}.mini.tg input{width:20px;height:20px;accent-color:var(--olive)}
.lowt{color:#9B5A0A;font-weight:500}
.adm-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:24px 22px;margin-top:18px}
.adm-login{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:24px 16px}
.adm-login .adm-card{width:100%;max-width:420px}
.adm-login h1{font-size:34px}
.alt2c{margin-top:18px;font-size:13px;color:var(--muted);text-align:center}
.msgi{align-items:flex-start}.msgi p{margin-top:8px;color:#46422F;font-size:15px;max-width:60ch}
.ma{display:flex;gap:10px;flex-wrap:wrap}
@media(max-width:900px){
 .adm-wrap{grid-template-columns:minmax(0,1fr)}
 .adm-side{position:static;height:auto;padding:14px 12px;flex-direction:column;gap:8px}
 .adm-brand{padding:0 6px}
 .adm-side nav{flex-direction:row;overflow-x:auto;scrollbar-width:none}.adm-side nav button{flex:none;gap:8px}
 .adm-foot{flex-direction:row;margin-top:0}
 .stats{grid-template-columns:1fr 1fr}
 .prow{grid-template-columns:1fr 1fr}.prow .pn{grid-column:1/-1}
}

.adm-main,.adm-side{min-width:0}
.li>*{min-width:0}

@media(max-width:640px){.ord2 .oi{flex:1 1 100%}.ord2 .oa{width:100%;justify-content:space-between}.msgi>div:first-child{flex:1 1 100%}}

.lngbtn{min-height:44px;min-width:52px;padding:0 14px;border-radius:999px;border:1.5px solid var(--line);background:transparent;color:var(--olive-d);font:600 13px var(--sans);letter-spacing:.06em;cursor:pointer}
.lngbtn:hover{border-color:var(--olive);background:rgba(92,107,46,.08)}
.lng-m{display:block;margin:16px 0 4px}
.adm-foot .lngbtn{color:#E6DEC9;border-color:rgba(247,243,235,.3);align-self:flex-start;margin:0 0 8px 12px;text-align:center}
@media(max-width:640px){.hdr-in>.lngbtn{display:none}}

@media(max-width:640px){.brand span{font-size:18px}.hdr-in{gap:2px;padding:0 14px}.brand{gap:8px}.brand img{width:38px;height:38px}}

/* ───────── additions for the real site ───────── */
.dc{display:contents}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.skip-link{position:absolute;left:12px;top:-60px;z-index:2000;background:var(--olive-d);color:#fff;padding:12px 18px;border-radius:0 0 10px 10px;text-decoration:none;font-weight:600}
.skip-link:focus{top:0}
.shopnote{background:#F6E7B8;color:#4A3708;text-align:center;font-size:14.5px;padding:10px 16px;border-bottom:1px solid rgba(122,86,15,.25)}
.shopnote.paused{background:#F3D2C6;color:#5A1F0C}
.btn:disabled,.btn[aria-disabled=true]{opacity:.55;cursor:not-allowed}
.card .soldout{position:absolute;left:12px;bottom:12px;background:var(--ink);color:#fff;font-size:12.5px;padding:4px 10px;border-radius:999px;z-index:2}
.lowstock{color:#8A3B0F;font-size:14px;margin-top:6px}
.draft{background:#FBEFD0;border:1px solid rgba(122,86,15,.35);color:#4A3708;padding:12px 16px;border-radius:10px;margin:0 0 18px;font-size:15px}
.fnote{font-size:13.5px;color:var(--muted);margin-top:10px}
.okmsg{color:var(--olive-d)}
.cart-est{font-size:13.5px;color:var(--muted);margin:2px 0 10px}
.cart-err{color:#8A2C0B;font-size:14px;margin:8px 0 0;min-height:20px}
.legal-note{font-size:13.5px;color:var(--muted)}
.oi-list{margin:8px 0 0;padding:0;list-style:none;font-size:14.5px;color:#46422F}
.stack{display:grid;gap:14px}
.ftr-biz{font-size:12.5px;color:var(--muted);max-width:1180px;margin:0 auto;padding:0 20px 18px}
/* welcome animation: never trap a visitor */
html[data-intro=off] #intro,html[data-intro=off] #introSkip,html[data-intro=off] #bee,html[data-intro=off] #fx{display:none!important}
#intro{animation:introFailsafe .01s linear 7s forwards}
@keyframes introFailsafe{to{opacity:0;visibility:hidden;pointer-events:none}}
@media(prefers-reduced-motion:reduce){#intro,#introSkip,#bee,#fx{display:none!important}}

/* ───────── admin (server-rendered version) ───────── */
.adm-side nav a{display:flex;align-items:center;justify-content:space-between;min-height:46px;padding:0 12px;border-radius:10px;background:transparent;color:#E6DEC9;font:500 15px var(--sans);text-decoration:none;text-align:left}
.adm-side nav a[aria-current=page]{background:rgba(247,243,235,.14);color:#fff}
.adm-side nav a:hover{background:rgba(247,243,235,.1)}
.adm-side nav a i{font-style:normal;background:var(--gold);color:var(--ink);font-size:12px;font-weight:600;min-width:22px;height:22px;border-radius:11px;display:flex;align-items:center;justify-content:center;padding:0 6px}
a.stat{text-decoration:none}
.adm-main .row2{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.adm-main label.f{display:flex;flex-direction:column;gap:5px;font-size:14px;color:var(--muted)}
.adm-main label.f input,.adm-main label.f textarea,.adm-main label.f select{min-height:44px;border:1.5px solid rgba(42,38,21,.28);border-radius:10px;padding:8px 12px;font:400 15px var(--sans);color:var(--ink);background:#fff;width:100%}
.adm-main label.f textarea{min-height:90px}
.adm-main .chk3{display:flex;align-items:center;gap:8px;font-size:15px}
.adm-main .chk3 input{width:20px;height:20px;accent-color:var(--olive)}
.adm-main .days{display:flex;flex-wrap:wrap;gap:8px 18px}
.adm-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 4px}
.adm-tabs a{padding:8px 14px;border-radius:999px;border:1.5px solid var(--line);text-decoration:none;font-size:14.5px;color:var(--olive-d)}
.adm-tabs a[aria-current=page]{background:var(--olive);border-color:var(--olive);color:#fff}
.addr{font-size:14px;color:#46422F;line-height:1.5;margin-top:6px}
.chkitem{display:flex;gap:8px;align-items:flex-start;font-size:15px}
.pack-day{margin-top:26px}
.pack-day h2{font-size:26px}
.pack-card{page-break-inside:avoid}
.warnbox{background:#FBEFD0;border:1px solid rgba(122,86,15,.35);color:#4A3708;padding:14px 16px;border-radius:12px;margin-top:16px;font-size:15px}
.warnbox ul{margin:6px 0 0 18px;padding:0}
@media print{
 .adm-side,.no-print,.flash{display:none!important}
 .adm-wrap{display:block}
 body.adm{background:#fff}
 .adm-main{max-width:none;padding:0}
}

/* ── Admin: product photos and colours ── */
.media-box{border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:grid;gap:12px;margin:0;min-width:0}
.media-box legend{font-weight:600;padding:0 6px}
.media-box .hint{font-size:13px;color:var(--muted);margin:0}
.media-grid{display:flex;flex-wrap:wrap;gap:12px;list-style:none;margin:0;padding:0}
.media-item{width:120px;display:grid;gap:6px}
.media-item img{width:120px;height:150px;object-fit:cover;border-radius:10px;background:#EFE6D0;display:block}
.media-tag{font-size:12px;color:var(--muted)}
.media-btns{display:flex;gap:4px}
.media-btns button,.color-row button{min-height:36px;padding:0 10px;border:1px solid var(--line);border-radius:8px;background:#fff;cursor:pointer;font:500 13px var(--sans)}
.media-btns button:disabled{opacity:.4;cursor:default}
.media-add{cursor:pointer;display:inline-flex}
.color-row{display:grid;grid-template-columns:48px 1fr 1fr auto;gap:8px;align-items:center}
.color-row input[type=color]{width:48px;height:44px;padding:2px;border:1.5px solid rgba(42,38,21,.28);border-radius:10px;background:#fff}
.color-row input[type=text]{min-height:44px;border:1.5px solid rgba(42,38,21,.28);border-radius:10px;padding:8px 12px;font:400 15px var(--sans);min-width:0}
@media(max-width:640px){.color-row{grid-template-columns:48px 1fr}.color-row input[type=text]{grid-column:2}.color-row button{grid-column:1/-1}}

/* ── Product photos and colour choice ── */
.card .ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .45s ease}
.card .ph img.b{opacity:0}
.card .ph:hover img.b,.card .ph:focus-visible img.b{opacity:1}
.gal img{width:100%;height:100%;object-fit:cover;display:block}
.it .th img{width:100%;height:100%;object-fit:cover;display:block}
.pth img{width:100%;height:100%;object-fit:cover;display:block}
a.add{display:inline-flex;align-items:center;text-decoration:none}
.colors{border:0;margin:18px 0 6px;padding:0}
.colors legend{font-size:14px;color:var(--muted);padding:0;margin-bottom:8px}
.colors legend b{color:var(--ink);font-weight:600}
.swatches{display:flex;flex-wrap:wrap;gap:8px}
.sw{position:relative;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:6px 14px 6px 8px;border:1.5px solid rgba(42,38,21,.28);border-radius:999px;background:#fff;cursor:pointer;font:500 14px var(--sans);color:var(--ink)}
.sw input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.sw i{width:26px;height:26px;border-radius:50%;border:1px solid rgba(42,38,21,.25);flex:none}
.sw.on{border-color:var(--olive,#5C6B2E);box-shadow:0 0 0 2px var(--olive,#5C6B2E)}
.sw:focus-within{outline:2px solid var(--olive,#5C6B2E);outline-offset:2px}
.colorwarn{min-height:20px;margin:6px 0 0;font-size:14px;color:#9a3412}
.it-color{display:flex;align-items:center;gap:6px;margin:2px 0 6px;font-size:13px;color:var(--muted)}
.it-color .swatch{width:14px;height:14px;border-radius:50%;border:1px solid rgba(42,38,21,.25);display:inline-block}
@media (prefers-reduced-motion:reduce){.card .ph img{transition:none}}

/* ── Header: centred brand, two-part language button ── */
.hdr{background:#FFFDF8;border-bottom:1px solid var(--gold)}
.hdr-in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;max-width:1240px;height:84px;padding:0 28px;gap:16px}
.hdr-l{display:flex;align-items:center}
.hdr-r{display:flex;align-items:center;justify-content:flex-end;gap:6px}
.hdr .brand{flex-direction:column;gap:4px;margin:0;text-align:center}
.hdr .brand img{width:40px;height:40px}
.hdr .brand span{font-size:22px;letter-spacing:.02em;line-height:1}
.hdr .nav{margin:0;gap:30px}
.hdr .nav a{white-space:nowrap;font-size:14.5px;letter-spacing:.04em;color:var(--olive-d);padding:6px 0;border-bottom:1px solid transparent;transition:border-color .25s ease}
.hdr .nav a:hover{border-color:var(--gold)}
.lngseg{display:inline-flex;border:1.5px solid var(--olive);border-radius:999px;overflow:hidden;margin-right:8px}
.lngseg>*{display:flex;align-items:center;justify-content:center;min-width:44px;height:36px;padding:0 10px;font:600 12px var(--sans);letter-spacing:.12em;text-decoration:none;color:var(--olive-d)}
.lngseg .on{background:var(--olive);color:#fff}
.lngseg a:hover{background:rgba(92,107,46,.12)}
.lngseg.mnu-lng{margin:16px 0 4px}
.ini{background:transparent;color:var(--olive-d);border:1.5px solid var(--olive);width:34px;height:34px;font-size:13px;transition:background .2s,color .2s}
#acBtn:hover .ini{background:var(--olive);color:#fff}
@media(max-width:1000px){
 .hdr .nav{display:none}
 .hdr .mbtn{display:flex}
}
@media(max-width:640px){
 .hdr-in{height:66px;padding:0 10px;gap:4px}
 .hdr .brand img{width:30px;height:30px}
 .hdr .brand span{font-size:15px}
 .hdr-r{gap:0}
 .hdr-r .lngseg{display:none}
}
@media(prefers-reduced-motion:reduce){.hdr .nav a,.ini{transition:none}}

/* Skip button must never outlive the intro */
#introSkip{animation:introFailsafe .01s linear 7s forwards}

/* ── Logo, skip button, phone header ── */
.hdr .brand img,#intro img{mix-blend-mode:multiply}
.hdr .brand{flex-direction:row;align-items:center;gap:12px}
.hdr .brand img{width:58px;height:58px}
.hdr .brand span{font-size:24px}
#introSkip{top:auto;right:auto;left:50%;bottom:calc(32px + env(safe-area-inset-bottom,0px));transform:translateX(-50%)}
@media(max-width:640px){
 .hdr-in{height:72px}
 .hdr .brand img{width:56px;height:56px}
 .hdr .brand span{display:none}
 #introSkip{bottom:calc(96px + env(safe-area-inset-bottom,0px))}
}

/* ── Header: handwritten wordmark ── */
.hdr .brand{flex-direction:row;align-items:center;gap:10px}
.hdr .brand img{width:44px;height:44px;mix-blend-mode:multiply}
.hdr .brand span.script{display:inline;font-family:var(--font-script),'Parisienne',cursive;font-size:32px;font-weight:400;letter-spacing:0;line-height:1;color:var(--olive-d)}
@media(max-width:640px){
 .hdr .brand img{width:34px;height:34px}
 .hdr .brand span.script{display:inline;font-size:23px}
}

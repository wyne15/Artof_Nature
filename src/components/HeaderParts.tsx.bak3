"use client";

import Image from "next/image";
import Link from "next/link";
import { usePathname } from "next/navigation";
import { useState } from "react";
import { useCart } from "./cart/CartProvider";

export function CartButton() {
  const { count, open, labels } = useCart();
  return (
    <button className="cartbtn" type="button" onClick={open} aria-label={labels.nav.bag}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.7" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>
      {count > 0 && <span className="cnt">{count}</span>}
    </button>
  );
}

/** Two-part language button (EN | RO). The current language is filled; the other is a real link (good for crawlers) that also remembers the choice in a small cookie. */
export function LangSwitch({ lang, label, full, mobile }: { lang: "en" | "ro"; label: string; full: string; mobile?: boolean }) {
  const path = usePathname() || `/${lang}`;
  const other = lang === "en" ? "ro" : "en";
  const href = path.replace(/^\/(en|ro)(?=\/|$)/, `/${other}`);
  const parts: ("en" | "ro")[] = ["en", "ro"];
  return (
    <span className={`lngseg${mobile ? " mnu-lng" : ""}`}>
      {parts.map((code) =>
        code === lang ? (
          <span key={code} className="on" aria-current="true">{code.toUpperCase()}</span>
        ) : (
          <a
            key={code}
            href={href}
            hrefLang={other}
            lang={other}
            aria-label={full}
            onClick={() => {
              document.cookie = `aon-lang=${other}; Max-Age=31536000; Path=/; SameSite=Lax${location.protocol === "https:" ? "; Secure" : ""}`;
            }}
          >
            {label}
          </a>
        )
      )}
    </span>
  );
}

type NavItem = { href: string; label: string };

/** The whole sticky header (client because of the mobile menu). The account button is passed in, already rendered on the server. */
export function HeaderShell(props: {
  lang: "en" | "ro";
  homeHref: string;
  homeLabel: string;
  brand: string;
  navLabel: string;
  items: NavItem[];
  accountItem: NavItem;
  switchLabel: string;
  switchFull: string;
  account: React.ReactNode;
}) {
  const [open, setOpen] = useState(false);
  const { labels } = useCart();
  return (
    <header className="hdr">
      <div className="hdr-in">
        <div className="hdr-l">
          <button className="cartbtn mbtn" id="mnuBtn" type="button" aria-expanded={open} aria-controls="mnu" aria-label={labels.nav.menu} onClick={() => setOpen((o) => !o)}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
          <nav className="nav" aria-label={props.navLabel}>
            {props.items.map((it) => (
              <Link key={it.href} href={it.href}>{it.label}</Link>
            ))}
          </nav>
        </div>
        <Link className="brand" href={props.homeHref} aria-label={props.homeLabel}>
          <Image id="hdrLogo" src="/logo.png" alt="" width={42} height={42} priority />
          <span>{props.brand}</span>
        </Link>
        <div className="hdr-r">
          <LangSwitch lang={props.lang} label={props.switchLabel} full={props.switchFull} />
          {props.account}
          <CartButton />
        </div>
      </div>
      <div id="mnu" hidden={!open}>
        {[...props.items, props.accountItem].map((it) => (
          <Link key={it.href} href={it.href} onClick={() => setOpen(false)}>{it.label}</Link>
        ))}
        <LangSwitch lang={props.lang} label={props.switchLabel} full={props.switchFull} mobile />
      </div>
    </header>
  );
}
